 },
 {
  "table": "collections_events",
  "check": "Collections event dated BEFORE the loan was originated",
  "affected": 3875,
  "total": 8635,
  "pct": 44.88,
  "status": "Issue",
  "severity": "High",
  "decision": "Use only counts/amounts per account; no date-based collections logic; never a model input",
  "rationale": "Event dates are unreliable, and collections happen AFTER delinquency, so they would leak the outcome."
 },
 {
  "table": "bureau_credit",
