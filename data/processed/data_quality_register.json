  "affected": 21104,
  "total": 33764,
  "pct": 62.5,
  "status": "Issue",
  "severity": "High",
  "decision": "Treat bureau as a CURRENT SNAPSHOT, not point-in-time; flag as production requirement",
  "rationale": "A real origination model needs as-of-date bureau pulls; here it is behavioural / monitoring scoring."
 }
